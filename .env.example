# ===== AI-bolat баптаулары (.env) =====
# Жергілікті (Windows ноутбук) үшін тек AI_API_KEY жеткілікті. Өндіріс (интернеттегі сайт) үшін төмендегі «ӨНДІРІС» бөлімін толтырыңыз.
PORT=8790
HOST=0.0.0.0

# --- AI (OpenAI-үйлесімді API) ---
# ӨНДІРІС үшін ұсыныс: OpenAI (балалар/оқушылар үшін қорғау шараларымен рұқсат етілген).
#   AI_BASE_URL=https://api.openai.com/v1
#   AI_MODEL=gpt-5-mini,gpt-5-nano
# Ескерту: Google Gemini API шарттары 18 жасқа толмағандарға арналған қосымшада қолдануға тыйым салады —
# Gemini-ді тек жеке/ішкі сынақ үшін қалдырыңыз.
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-flash-latest
# AI_PROVIDER_NAME=OpenAI API (OpenAI, L.L.C.)   # құпиялылық саясатында көрсетілетін атау (әдепкі: AI_BASE_URL бойынша)
# AI_CHILD_SAFETY=1                               # балаларға қауіпсіздік жүйелік нұсқауы (әдепкі қосулы)
# AI_REASONING_EFFORT=minimal                     # gpt-5* үшін

# --- SMS (SMS_PROVIDER бос = DEV: код экранда; өндірісте DEV әдепкі бойынша ӨШІРУЛІ) ---
# Mobizon (Қазақстан): https://mobizon.kz -> кабинет -> API кілті
# SMS_PROVIDER=mobizon
# MOBIZON_API_KEY=
# MOBIZON_DOMAIN=api.mobizon.kz
# MOBIZON_FROM=            (бекітілген жіберуші атауы, міндетті емес)
# SMSC.kz:  SMS_PROVIDER=smsc  SMSC_LOGIN=  SMSC_PASSWORD=  SMSC_SENDER=
# Twilio:   SMS_PROVIDER=twilio TWILIO_SID=  TWILIO_TOKEN=  TWILIO_FROM=

# ===== ӨНДІРІС =====
# NODE_ENV=production
# PUBLIC_URL=https://aibolat.kz            # сайттың нақты мекенжайы (https!). sitemap, canonical, OG, cookie Secure осыдан
# DOMAIN=aibolat.kz                        # тек docker-compose + Caddy үшін (VPS)
# DATA_DIR=/data                           # SQLite базасы, суреттер, резервтік көшірмелер (тұрақты диск!)
# DATA_LOCATION=kz                         # құпиялылық саясаты үшін: kz | eu | us
# APP_SECRET=                              # ұзын кездейсоқ жол (SMS-код хештері); бос болса DATA_DIR/secret.key жасалады
# TRUST_PROXY=1                            # прокси артында (Caddy/Render/Fly) — өндірісте әдепкі 1
# COOKIE_SECURE=1                          # өндірісте https болса әдепкі 1
# ALLOW_DEV_SMS=0                          # 1 = SMS провайдерінсіз кодты экранда көрсету (ТЕК сынақ!)
# REQUIRE_CONSENT=1                        # тіркелуде келісім белгісі (өндірісте әдепкі 1)

# --- Демо аккаунттар (+77000000001 / demo1234 т.б.) ---
# SEED_DEMO=0                              # өндірісте әдепкі 0: бос базаға демо деректер жасалмайды
# DEMO_LOGIN=0                             # өндірісте әдепкі 0: демо аккаунттармен кіру жабық
# DEMO_PASSWORD=                           # орнатылса, барлық демо аккаунт құпиясөзі осыған ауысады (≥ 8 таңба)

# --- Әкімші ---
# ADMIN_PHONES=+77011234567               # осы нөмірлер әкімші болады (үтірмен бірнеше)
# ADMIN_SETUP_TOKEN=                       # /setup беті: SMS-сіз алғашқы әкімшіні жасау (әкімші пайда болған соң жабылады)

# --- Жария беттер / SEO ---
# ORG_NAME=ЖК «...» / Мектеп атауы          # құпиялылық саясатындағы Оператор
# CONTACT_EMAIL=support@aibolat.kz
# GOOGLE_SITE_VERIFICATION=                # Search Console HTML-тег әдісі (content="..." мәні)
# PLAY_URL=https://play.google.com/store/apps/details?id=kz.aibolat.app
# LEGAL_UPDATED=2026-09-29

# --- Android TWA (Digital Asset Links: /.well-known/assetlinks.json) ---
# ANDROID_PACKAGE=kz.aibolat.app
# ANDROID_CERT_SHA256=AA:BB:...            # Play Console -> App integrity -> App signing key SHA-256 (upload key әдепкі қосылған)

# --- Шектеулер және резервтік көшірме ---
# RATE_LIMIT_PER_MIN=300                   # бір IP-ден /api сұраныстары
# AI_LIMIT_PER_MIN=20                      # бір пайдаланушыға AI сұраныстары
# AI_LIMIT_PER_DAY=300
# BACKUP_HOURS=24                          # DATA_DIR/backups ішіне көшірме (өндірісте әдепкі 24)
# BACKUP_KEEP=7
